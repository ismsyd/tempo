{
  "manifest_version": 3,
  "name": "Tempo",
  "short_name": "Tempo",
  "version": "0.2.0",
  "description": "Tells the Tempo app on this computer which website you are on (Chrome or Brave). Sends nothing anywhere else.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:4747/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tempo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "120"
}
