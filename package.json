{
  "name": "tempo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tempo/web",
    "build": "npm run build -w @tempo/web",
    "typecheck": "tsc -p packages/shared && tsc -p apps/web --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
